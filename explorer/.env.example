# Base URLs for the Trident REST API (no trailing slash)
TRIDENT_TESTNET_API_URL=https://api.testnet.trident.dev
TRIDENT_MAINNET_API_URL=https://api.mainnet.trident.dev

# Internal API keys for the explorer (free tier — created at deploy time, never
# exposed to clients). Trident API keys are network-scoped, so each network
# needs its own key — a testnet key will not read mainnet data and vice versa.
EXPLORER_TESTNET_API_KEY=your_internal_testnet_explorer_api_key
EXPLORER_MAINNET_API_KEY=your_internal_mainnet_explorer_api_key

# Soroban RPC endpoints used to probe a contract on-chain (best-effort:
# distinguishes "not indexed yet" from "no events yet"). Defaults shown;
# override if you operate your own RPC.
TRIDENT_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
TRIDENT_MAINNET_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com